# Пример окружения для safe-accounts.
# Скопируйте в .env и заполните РЕАЛЬНЫМИ значениями.
# Файл .env добавлен в .gitignore и НИКОГДА не должен попадать в репозиторий.

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=safe_accounts
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me

# --- Мастер-ключ (KEK) для шифрования DEK пользователей ---
# Ровно один из двух вариантов обязателен, иначе приложение не стартует.
# Вариант 1: ключ base64 (32 байта), сгенерировать: ./scripts/generate-master-key.sh
VAULT_MASTER_KEY_BASE64=
# Вариант 2: путь к файлу, содержащему ключ base64 в первой строке
VAULT_MASTER_KEY_FILE=

# --- Приложение ---
SERVER_PORT=8080
# Профили: default | docker (через запятую при необходимости)
SPRING_PROFILES_ACTIVE=default
